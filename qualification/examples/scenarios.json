 "word_counter": {
  "py": [
   {
    "op": "expect_text",
    "contains": [
     "Press Count to start.",
     "Source: generated sample text"
    ]
   },
   {
    "op": "expect_disabled",
    "label": "Cancel",
    "value": true
   },
   {
    "op": "click",
    "label": "Count"
   },
   {
    "op": "wait_text",
    "contains": [
     "Done: 180,000 words, 13 different, 20,000 lines.",
     "the: 25,714",
     "dog: 12,860",
     "render: 12,856"
