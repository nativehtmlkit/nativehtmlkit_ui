   {
    "op": "expect_disabled",
    "label": "Add expense",
    "value": true
   },
   {
    "op": "type",
    "label": "Description",
    "value": "Coffee"
   },
   {
    "op": "type",
    "label": "Amount",
    "value": "three"
   },
   {
    "op": "click",
    "label": "Add expense"
   },
   {
    "op": "expect_text",
    "contains": [
     "Amount must be a number"
    ]
   },
   {
    "op": "type",
    "label": "Amount",
    "value": "-1"
   },
   {
    "op": "click",
    "label": "Add expense"
   },
   {
    "op": "expect_text",
    "contains": [
     "Amount must be greater than zero"
    ]
   },
   {
    "op": "type",
    "label": "Amount",
    "value": "3.5"
   },
   {
    "op": "choose",
    "label": "Category",
    "value": "other"
   },
   {
    "op": "click",
    "label": "Add expense"
   },
   {
    "op": "expect_text",
    "contains": [
     "Coffee (Other): 3.50"
    ],
    "absent": [
     "Amount must"
    ]
   }
  ]
 },
 "settings_editor": {
  "args": [
   "settings.json"
  ],
  "steps": [
   {
    "op": "expect_text",
    "contains": [
     "Settings",
     "All changes saved",
     "Enter a display name.",
     "Editing "
    ]
   },
   {
    "op": "expect_value",
    "label": "Refresh interval (seconds)",
    "value": "60"
   },
   {
    "op": "type",
    "label": "Display name",
    "value": "Grace"
   },
   {
    "op": "type",
    "label": "E-mail",
    "value": "grace@example"
   },
   {
    "op": "expect_text",
    "contains": [
     "Unsaved changes",
     "The e-mail address looks invalid."
    ]
   },
   {
    "op": "click",
    "label": "Save"
   },
   {
    "op": "expect_text",
    "contains": [
     "Fix the problem above before saving."
    ]
   },
   {
    "op": "type",
    "label": "E-mail",
    "value": "grace@example.org"
   },
   {
    "op": "type",
    "label": "Refresh interval (seconds)",
    "value": "2"
   },
   {
    "op": "expect_text",
    "contains": [
     "Refresh interval must be a whole number from 5 to 3600."
    ]
   },
   {
    "op": "type",
    "label": "Refresh interval (seconds)",
    "value": "30"
   },
   {
    "op": "choose",
    "label": "Theme (applies on next start)",
    "value": "daylight"
   },
   {
    "op": "check",
    "label": "Send me e-mail notifications",
    "value": true
   },
   {
    "op": "expect_text",
    "contains": [
     "Unsaved changes"
    ],
    "absent": [
     "Enter a display name.",
     "looks invalid",
     "Refresh interval must"
    ]
   },
   {
    "op": "click",
    "label": "Save"
   },
   {
    "op": "expect_text",
    "contains": [
     "All changes saved",
     "Saved "
    ]
   },
   {
    "op": "type",
    "label": "Display name",
    "value": "Someone else"
   },
   {
    "op": "check",
    "label": "Send me e-mail notifications",
    "value": false
   },
   {
    "op": "expect_text",
    "contains": [
     "Unsaved changes"
    ]
   },
   {
    "op": "click",
    "label": "Revert"
   },
   {
    "op": "expect_value",
    "label": "Display name",
    "value": "Grace"
   },
   {
    "op": "expect_value",
    "label": "Send me e-mail notifications",
    "checked": true
   },
   {
    "op": "expect_value",
    "label": "Theme (applies on next start)",
    "value": "daylight"
   },
   {
    "op": "expect_text",
    "contains": [
     "All changes saved",
     "Reverted to the saved file"
    ]
   }
  ]
 },
